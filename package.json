{
  "name": "emprest-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API backend do Emprest.AI",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "dotenv -e .env.local -- ts-node src/main.ts",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:create": "dotenv -e .env.local -- prisma migrate dev --create-only --name initial_catalog_profile",
    "db:seed": "dotenv -e .env.local -- ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
